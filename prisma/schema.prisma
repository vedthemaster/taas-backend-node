generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  telegramConfig TelegramConfig?
  folders        Folder[]
  files          File[]
}

model TelegramConfig {
  id            String            @id @default(uuid())
  userId        String            @unique
  channelId     String            // Primary/default channel for all bots
  botToken      String?           // Primary bot token for Telethon operations
  apiId         String?           // Telegram API ID for MTProto
  apiHash       String?           // Telegram API Hash for MTProto
  useSystemBots Boolean           @default(false) // True if user skipped setup and uses system bots
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bots          TelegramBot[]
  channels      TelegramChannel[] // Additional channels for throughput
}

model TelegramChannel {
  id        String         @id @default(uuid())
  configId  String
  channelId String         // Telegram channel ID (e.g., -1001234567890)
  name      String?        // Optional friendly name
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  config    TelegramConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, channelId])
  @@index([configId])
}

model TelegramBot {
  id            String          @id @default(uuid())
  configId      String
  botToken      String
  botUsername   String?         // Fetched from Telegram getMe
  lastMessageAt DateTime?       // For rate limiting (20 msg/min = 1 per 3 sec)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  config        TelegramConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  files     File[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
}

model File {
  id              String       @id @default(uuid())
  name            String
  size            BigInt
  mimeType        String
  telegramFileId  String?      // null for chunked files
  telegramMsgId   Int?         // null for chunked files
  channelId       String?      // Channel where file is stored (for non-chunked files)
  isChunked       Boolean      @default(false)
  totalChunks     Int?
  folderId        String?
  userId          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  folder          Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks          FileChunk[]

  @@index([userId])
  @@index([folderId])
}

model FileChunk {
  id              String   @id @default(uuid())
  fileId          String
  chunkIndex      Int
  telegramFileId  String
  telegramMsgId   Int
  channelId       String?  // Channel where this chunk is stored
  size            BigInt
  createdAt       DateTime @default(now())
  file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([fileId])
}

